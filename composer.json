{
  "name": "candidate/inventory-reservations",
  "description": "API de reservas de inventario con idempotencia y concurrencia en MySQL",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "~8.3.0 || ~8.4.0",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": { "phpunit/phpunit": "^12.5" },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "config": { "sort-packages": true, "allow-plugins": false },
  "scripts": {
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test": "phpunit"
  }
}
